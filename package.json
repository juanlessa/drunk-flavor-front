{
	"name": "nuxt-app",
	"private": true,
	"type": "module",
	"overrides": {
		"@histoire/plugin-nuxt": {
			"nuxt": "$nuxt"
		},
		"vue-i18n": "11.4.14",
		"@intlify/shared": "11.4.10",
		"@intlify/core-base": "11.4.14",
		"@intlify/message-compiler": "11.4.14",
		"glob": "13.0.6"
	},
	"scripts": {
		"build": "nuxt build",
		"start": "node .output/server/index.mjs",
		"dev": "nuxt dev",
		"test": "vitest run -c vitest.config.ts",
		"test:watch": "vitest -c vitest.config.ts",
		"story:dev": "HISTOIRE=true histoire dev",
		"story:build": "HISTOIRE=true histoire build",
		"story:preview": "HISTOIRE=true histoire preview",
		"lint": "eslint .",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@fontsource/roboto": "5.3.0",
		"nanoid": "6.0.1",
		"nuxt": "4.4.8",
		"radix-vue": "1.9.17",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"vue": "3.5.42",
		"vue-router": "5.4.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@histoire/plugin-nuxt": "1.0.0-beta.1",
		"@histoire/plugin-vue": "1.0.0-beta.1",
		"@internationalized/date": "3.12.4",
		"@internationalized/number": "3.6.9",
		"@nuxt/eslint": "1.17.0",
		"@nuxt/test-utils": "4.3.2",
		"@nuxtjs/i18n": "10.6.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/vue": "8.1.0",
		"@types/eslint-config-prettier": "6.11.3",
		"@vue/test-utils": "2.5.1",
		"@vueuse/core": "15.0.0",
		"@vueuse/nuxt": "15.0.0",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"happy-dom": "21.0.1",
		"histoire": "1.0.0-beta.1",
		"nuxt-typed-router": "4.0.11",
		"playwright-core": "1.64.1",
		"prettier": "3.9.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vitest": "4.1.11",
		"vue-tsc": "3.3.11"
	}
}
