{
	"name": "nuxt-app",
	"private": true,
	"type": "module",
	"overrides": {
		"@histoire/plugin-nuxt": {
			"nuxt": "$nuxt"
		},
		"vue-i18n": "11.4.16",
		"@intlify/shared": "11.4.16",
		"@intlify/core-base": "11.4.16",
		"@intlify/message-compiler": "11.4.16",
		"glob": "14.0.3"
	},
	"scripts": {
		"build": "nuxt build",
		"start": "node .output/server/index.mjs",
		"dev": "nuxt dev",
		"test": "NODE_ENV=test vitest run -c vitest.config.ts",
		"test:unit": "NODE_ENV=test vitest run -c vitest.config.ts --project node --project happy-dom",
		"test:a11y": "NODE_ENV=test vitest run -c vitest.config.ts --project a11y",
		"test:a11y:browser": "A11Y_BROWSER=true NODE_ENV=test vitest run -c vitest.config.ts --project a11y-browser",
		"test:nuxt": "NODE_ENV=test vitest run -c vitest.config.ts --project nuxt",
		"test:coverage": "NODE_ENV=test vitest run -c vitest.config.ts --coverage",
		"test:watch": "NODE_ENV=test vitest -c vitest.config.ts",
		"story:dev": "HISTOIRE=true histoire dev",
		"story:build": "HISTOIRE=true histoire build",
		"story:preview": "HISTOIRE=true histoire preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:staged": "lint-staged",
		"typecheck": "vue-tsc --noEmit",
		"generate": "nuxt generate",
		"pwa:assets": "pwa-assets-generator --config pwa-assets.config.ts",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"prepare": "husky",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"format:staged": "pretty-quick --staged"
	},
	"dependencies": {
		"@casl/ability": "7.1.1",
		"@casl/vue": "3.1.0",
		"@fontsource/roboto": "5.3.0",
		"@vueuse/integrations": "15.0.0",
		"nanoid": "6.0.2",
		"nuxt": "4.6.4",
		"radix-vue": "1.9.17",
		"sortablejs": "1.15.7",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"vue": "3.5.44",
		"vue-router": "5.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@histoire/plugin-nuxt": "1.0.0-beta.1",
		"@histoire/plugin-vue": "1.0.0-beta.1",
		"@internationalized/date": "3.12.4",
		"@internationalized/number": "3.6.9",
		"@nuxt/eslint": "1.17.0",
		"@nuxt/test-utils": "4.3.4",
		"@nuxtjs/i18n": "10.6.0",
		"@nuxtjs/robots": "6.2.4",
		"@nuxtjs/sitemap": "8.6.2",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/vue": "8.1.0",
		"@types/eslint-config-prettier": "6.11.3",
		"@types/sortablejs": "1.15.9",
		"@vite-pwa/assets-generator": "1.0.4",
		"@vite-pwa/nuxt": "1.1.1",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/coverage-v8": "5.0.5",
		"@vue/test-utils": "2.5.1",
		"@vueuse/core": "15.0.0",
		"@vueuse/nuxt": "15.0.0",
		"axe-core": "4.14.0",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.7",
		"happy-dom": "21.0.4",
		"histoire": "1.0.0-beta.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"nuxt-security": "2.7.0",
		"nuxt-typed-router": "4.0.10",
		"playwright": "1.64.1",
		"playwright-core": "1.64.1",
		"prettier": "3.9.10",
		"pretty-quick": "4.2.2",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vitest": "5.0.5",
		"vue-tsc": "3.3.14"
	}
}
