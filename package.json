{
	"name": "nuxt-app",
	"private": true,
	"type": "module",
	"overrides": {
		"@histoire/plugin-nuxt": {
			"nuxt": "$nuxt"
		},
		"vue-i18n": "11.1.3",
		"@intlify/shared": "11.4.6",
		"@intlify/core-base": "11.4.6",
		"@intlify/message-compiler": "11.4.6",
		"glob": "11.1.0"
	},
	"scripts": {
		"build": "nuxt build",
		"start": "node .output/server/index.mjs",
		"dev": "nuxt dev",
		"test": "vitest run -c vitest.config.ts",
		"test:watch": "vitest -c vitest.config.ts",
		"story:dev": "HISTOIRE=true histoire dev",
		"story:build": "HISTOIRE=true histoire build",
		"story:preview": "HISTOIRE=true histoire preview",
		"lint": "eslint .",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write ."
	},
	"dependencies": {
		"nanoid": "6.0.0",
		"nuxt": "4.4.8",
		"radix-vue": "1.9.17",
		"tailwind-variants": "3.2.2",
		"tailwind-merge": "3.6.0",
		"vue": "3.5.39",
		"vue-router": "5.2.0",
		"vue3-dropzone": "2.2.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@histoire/plugin-nuxt": "1.0.0-beta.1",
		"@histoire/plugin-vue": "1.0.0-beta.1",
		"@internationalized/date": "3.12.2",
		"@internationalized/number": "3.6.7",
		"@nuxt/eslint": "1.16.0",
		"@nuxt/test-utils": "4.0.3",
		"@nuxtjs/i18n": "10.4.1",
		"@testing-library/vue": "8.1.0",
		"@types/eslint-config-prettier": "6.11.3",
		"@vue/test-utils": "2.4.11",
		"@tailwindcss/vite": "4.3.2",
		"@vueuse/core": "14.3.0",
		"@vueuse/nuxt": "14.3.0",
		"eslint": "10.7.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"happy-dom": "20.10.6",
		"histoire": "1.0.0-beta.1",
		"nuxt-typed-router": "4.0.10",
		"playwright-core": "1.61.1",
		"prettier": "3.9.5",
		"tailwindcss": "4.3.2",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "4.1.10"
	}
}
